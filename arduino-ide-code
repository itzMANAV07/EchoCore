// =============================================================
//  SEND SENSOR DATA TO FLASK
// =============================================================
void sendToFlask(bool motion, bool gas, int gasVal,
                 float temp, float hum, bool fan, bool clapLed, bool alertLed) {
  if (WiFi.status() != WL_CONNECTED) return;

  HTTPClient http;
  http.begin(serverURL);
  http.addHeader("Content-Type", "application/json");

  String payload = "{";
  payload += "\"temp\":"      + String(temp, 1)      + ",";
  payload += "\"humidity\":"  + String(hum, 1)       + ",";
  payload += "\"motion\":"    + String(motion ? 1:0) + ",";
  payload += "\"gas\":"       + String(gas    ? 1:0) + ",";
  payload += "\"gas_val\":"   + String(gasVal)        + ",";
  payload += "\"fan\":"       + String(fan    ? 1:0) + ",";
  payload += "\"clap_led\":"  + String(clapLed? 1:0) + ",";
  payload += "\"alert_led\":" + String(alertLed?1:0);
  payload += "}";

  int code = http.POST(payload);
  if (code > 0) {
    Serial.println("Sent to Flask: " + String(code));
  } else {
    Serial.println("Flask POST failed: " + String(code));
  }
  http.end();
}

// =============================================================
//  ESP32 COMMAND ENDPOINTS
// =============================================================
void handleFanOn()       { fanManual = true;    updateFan(); server.send(200, "text/plain", "Fan ON");        }
void handleFanOff()      { fanManual = false;   updateFan(); server.send(200, "text/plain", "Fan OFF");       }
void handleBuzzerOn()    { buzzerManual = true;  digitalWrite(BUZZER_PIN, HIGH); server.send(200, "text/plain", "Buzzer ON");   }
void handleBuzzerOff()   { buzzerManual = false; digitalWrite(BUZZER_PIN, LOW);  server.send(200, "text/plain", "Buzzer OFF");  }
void handleLedOn()       { clapLedState = true;  digitalWrite(CLAP_LED_PIN, HIGH); server.send(200, "text/plain", "LED ON");   }
void handleLedOff()      { clapLedState = false; digitalWrite(CLAP_LED_PIN, LOW);  server.send(200, "text/plain", "LED OFF");  }
void handleAlertLedOn()  { alertLedManual = true;  digitalWrite(RED_LED_PIN, HIGH); server.send(200, "text/plain", "Alert LED ON");  }
void handleAlertLedOff() { alertLedManual = false; digitalWrite(RED_LED_PIN, LOW);  server.send(200, "text/plain", "Alert LED OFF"); }
void handleStatus()      { server.send(200, "text/plain", "EchoCore OK"); }

// =============================================================
//  SETUP
// =============================================================
void setup() {
  pinMode(RELAY_PIN, OUTPUT);
  digitalWrite(RELAY_PIN, HIGH);

  Serial.begin(115200);

  pinMode(PIR_PIN,      INPUT_PULLDOWN);
  pinMode(MQ2_DO_PIN,   INPUT);
  pinMode(BUZZER_PIN,   OUTPUT);
  pinMode(RED_LED_PIN,  OUTPUT);
  pinMode(CLAP_LED_PIN, OUTPUT);

  digitalWrite(BUZZER_PIN,   LOW);
  digitalWrite(RED_LED_PIN,  LOW);
  digitalWrite(CLAP_LED_PIN, LOW);

  Wire.begin(SDA_PIN, SCL_PIN);
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("OLED not found!");
    while (true);
  }

  dht.begin();
  showConnecting();

  WiFi.begin(ssid, password);
  Serial.print("Connecting to WiFi");
  int tries = 0;
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
    tries++;
    if (tries > 40) {
      Serial.println("\nWiFi failed!");
      display.clearDisplay();
      display.setCursor(5, 20);
      display.println("WiFi Failed!");
      display.display();
      while (true);
    }
  }

  Serial.println("\nWiFi connected!");
  Serial.print("ESP32 IP: ");
  Serial.println(WiFi.localIP());
  showConnected(WiFi.localIP().toString());

  server.on("/fan/on",       handleFanOn);
  server.on("/fan/off",      handleFanOff);
  server.on("/buzzer/on",    handleBuzzerOn);
  server.on("/buzzer/off",   handleBuzzerOff);
  server.on("/led/on",       handleLedOn);
  server.on("/led/off",      handleLedOff);
  server.on("/alertled/on",  handleAlertLedOn);
  server.on("/alertled/off", handleAlertLedOff);
  server.on("/status",       handleStatus);
  server.begin();

  Serial.println("EchoCore ready!");
  Serial.println("Give this IP to Flask: " + WiFi.localIP().toString());
}

// =============================================================
//  LOOP
// =============================================================
void loop() {
  server.handleClient();

  bool  motion   = digitalRead(PIR_PIN);
  int   gasVal   = analogRead(MQ2_AO_PIN);
  bool  gas      = (gasVal > GAS_THRESHOLD);
  float temp     = dht.readTemperature();
  float hum      = dht.readHumidity();

  if (motion) showMotion();
  if (gas)    showGas();

  bool alertLedState = updateAlertLed(motion, gas);
  updateBuzzer(gas);

  if (!motion && !gas) showWelcome();

  if (!isnan(temp)) fanByTemp = (temp > TEMP_THRESHOLD);
  updateFan();

  if (millis() - lastSendTime >= sendInterval) {
    lastSendTime = millis();
    sendToFlask(motion, gas, gasVal,
                isnan(temp) ? 0 : temp,
                isnan(hum)  ? 0 : hum,
                fanByTemp || fanManual,
                clapLedState,
                alertLedState);
  }

  delay(100);
}
