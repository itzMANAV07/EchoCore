// ============================================================
//  EchoCore - ESP32 Station Mode
//  Connects to home WiFi and talks to Flask server
//  Sends sensor data every 2 seconds via HTTP POST
//  Receives commands via HTTP endpoints
//  Buzzer: ONLY on gas detection (not motion)
//  Alert LED: ON when motion OR gas detected, plus manual control
//  Clap/sound LED toggling REMOVED — Clap LED only via website/voice
// ============================================================

#include <WiFi.h>
#include <WebServer.h>
#include <HTTPClient.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <DHT.h>

// ── WiFi Credentials ──────────────────────────────────────────
const char* ssid      = "SKY";
const char* password  = "sky@2007";
const char* serverURL = "http://10.198.46.196:5000/data";

// ── OLED ──────────────────────────────────────────────────────
#define SCREEN_WIDTH  128
#define SCREEN_HEIGHT  64
#define OLED_RESET     -1
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

// ── Pin Definitions ───────────────────────────────────────────
#define SDA_PIN      21
#define SCL_PIN      22
#define PIR_PIN      27
#define MQ2_DO_PIN   25
#define MQ2_AO_PIN   35
#define BUZZER_PIN    5
#define RED_LED_PIN   4
#define CLAP_LED_PIN  2
#define RELAY_PIN    32
#define DHT_PIN      14
#define DHT_TYPE     DHT11

// ── Thresholds ────────────────────────────────────────────────
#define GAS_THRESHOLD  1500
#define TEMP_THRESHOLD 35.0

// ── Objects ───────────────────────────────────────────────────
WebServer server(80);
DHT       dht(DHT_PIN, DHT_TYPE);

// ── State ─────────────────────────────────────────────────────
bool          clapLedState    = false;
bool          alertLedManual  = false;
bool          fanManual       = false;
bool          fanByTemp       = false;
bool          buzzerManual    = false;
unsigned long lastSendTime    = 0;
const long    sendInterval    = 2000;

// =============================================================
//  FAN UPDATE — active-LOW relay
// =============================================================
void updateFan() {
  bool state = fanByTemp || fanManual;
  digitalWrite(RELAY_PIN, state ? LOW : HIGH);
}

// =============================================================
//  BUZZER UPDATE — only gas + manual, NOT motion
// =============================================================
void updateBuzzer(bool gasActive) {
  bool state = gasActive || buzzerManual;
  digitalWrite(BUZZER_PIN, state ? HIGH : LOW);
}

// =============================================================
//  ALERT LED UPDATE — motion OR gas OR manual override
// =============================================================
bool updateAlertLed(bool motion, bool gas) {
  bool state = motion || gas || alertLedManual;
  digitalWrite(RED_LED_PIN, state ? HIGH : LOW);
  return state;
}

